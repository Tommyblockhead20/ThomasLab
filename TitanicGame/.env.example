# Copy to .env for the Node server. Do not commit .env.
PORT=3001
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3001,http://127.0.0.1:3001,https://thomaslab.me,https://www.thomaslab.me

# Set to your server's public IPv4 for public voice hosting.
# PUBLIC_IP=203.0.113.10
RTC_PORT_MIN=40000
RTC_PORT_MAX=40100

# Local tests work without an external STUN or TURN service.
# Public hosting generally needs STUN, and restrictive networks need TURN.
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=titanic
# TURN_PASSWORD=replace-with-a-long-random-password

# Set at BUILD time for a client hosted separately, e.g. GitHub Pages.
# This is a public server address, never a password.
# VITE_GAME_SERVER_URL=https://titanic.example.com

# Development-only controls. Leave off in production.
ALLOW_DEV_TOOLS=0
# MATCH_SEED=1234
