{
  "name": "titanic-altered-history",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite --configLoader native --host 0.0.0.0\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --configLoader native --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --configLoader native && tsup server/index.ts --format esm --platform node --target node22 --out-dir build/server --external werift",
    "start": "node build/server/index.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "balance": "tsx tools/balance-check.ts",
    "format": "prettier --write src shared server test tools vite.config.ts",
    "test:crew": "tsx tools/test-crew.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "werift": "^0.22.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
